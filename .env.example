# Copy to .env — never commit real secrets.
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=finalcut_social
JWT_SECRET=generate_with_openssl_rand_64_hex
CORS_ORIGIN=http://localhost:3000,https://www.finalcut.ai
NEXT_PUBLIC_API_URL=/api
DATABASE_URL=postgres://admin:change_me@localhost:5432/finalcut_social
SETUP_TOKEN=only_for_one_time_db_bootstrap

# Managed Postgres TLS (e.g. Supabase/RDS/Neon). Defaults: TLS on for public hosts,
# off for localhost/docker service names. Override with `require|verify-full|disable`.
# DATABASE_SSLMODE=require
# Pin the provider CA (PEM) to actually verify the chain; \n-escaped is fine.
# DATABASE_CA_CERT=
