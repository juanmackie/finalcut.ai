# Database — Neon (serverless Postgres, free tier)
# Sign up at neon.tech → create project → copy connection string
DATABASE_URL=postgresql://ep-name.region.aws.neon.tech/dbname?sslmode=require

# Auth
JWT_SECRET=generate_with_openssl_rand_64_hex

# CORS
CORS_ORIGIN=http://localhost:3000,https://www.finalcut.ai

# App
NEXT_PUBLIC_API_URL=/api
SETUP_TOKEN=only_for_one_time_db_bootstrap
